{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "swinog/agenda",
	"title": "SwiNOG · Recent talks",
	"category": "theme",
	"icon": "microphone",
	"description": "Dynamic grid of recent talks pulled from the wp-swinog-events plugin. Filter by one or more event tags (e.g. swinog-41, swinog-40).",
	"keywords": ["agenda", "talks", "presentations", "swinog"],
	"supports": {
		"html": false,
		"align": ["wide", "full"],
		"spacing": { "margin": true, "padding": true }
	},
	"attributes": {
		"events":       { "type": "string", "default": "" },
		"count":        { "type": "number", "default": 6 },
		"columns":      { "type": "number", "default": 2 },
		"kicker":       { "type": "string", "default": "" },
		"title":        { "type": "string", "default": "Recent talks worth your time." },
		"archiveLabel": { "type": "string", "default": "Full archive →" },
		"archiveUrl":   { "type": "string", "default": "https://www.youtube.com/@swinog" }
	},
	"editorScript": "file:./index.js",
	"render":       "file:./render.php",
	"textdomain":   "swinog"
}
