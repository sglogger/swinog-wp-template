# Local dev only. Copy to .env and override if you want.
#
# The swinog-theme/ host directory is empty until the theme is built — WordPress
# will fall back to its bundled default theme on first install. Once swinog-theme/
# contains at least a style.css with a Theme Name header, activate it via
# Appearance → Themes in wp-admin.
#
# The MySQL/WP data live in Docker named volumes (db_data, wp_core), not on the
# host. `docker compose down -v` wipes them for a fresh start.

WP_PORT=8080
PMA_PORT=8081
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=rootpass
